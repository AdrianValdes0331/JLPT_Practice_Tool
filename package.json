{
  "name": "jlpt-practice-tool",
  "version": "1.0.0",
  "description": "JLPT N3 vocabulary quiz desktop app",
  "main": "main.js",
  "scripts": {
    "build-data": "node tools/build_data.js",
    "start": "npm run build-data && electron .",
    "dist": "npm run build-data && electron-builder --win portable",
    "build-mobile": "npm run build-data && node tools/build_mobile.js",
    "android:sync": "npm run build-mobile && cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew.bat --no-daemon assembleDebug",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "test:mobile": "node --test tools/build_mobile.test.js",
    "test:progress": "node --test tools/progress.test.js"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "kuroshiro": "^1.2.1",
    "kuroshiro-analyzer-kuromoji": "^1.1.0"
  },
  "build": {
    "appId": "com.local.jlptpractice",
    "productName": "JLPT Practice Tool",
    "files": [
      "main.js",
      "renderer/**/*",
      "Icons/icon.ico"
    ],
    "win": {
      "icon": "Icons/icon.ico"
    }
  },
  "dependencies": {
    "lucide": "^1.70.0"
  }
}
